# ==============================================================================
# CloudDoc AI - Production & Development Environment Configuration
# ==============================================================================
# SECURITY NOTICE: Never commit actual secret keys or credentials to version control.
# On AWS EC2 production, prefer AWS IAM Instance Profiles over static ACCESS_KEY_IDs.

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_NAME=CloudDoc AI
APP_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Amazon RDS)
# ------------------------------------------------------------------------------
# Production RDS format: postgresql://<user>:<password>@<rds-endpoint>.us-east-1.rds.amazonaws.com:5432/clouddoc_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clouddoc_db?schema=public"

# ------------------------------------------------------------------------------
# Redis Cache & Background Queue (BullMQ / AWS ElastiCache)
# ------------------------------------------------------------------------------
# Format: redis://:<password>@<redis-endpoint>:6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# AWS S3 Document Storage
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=clouddoc-documents-prod
# Leave empty on EC2 when using IAM Instance Roles:
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Set to 'true' to use local filesystem adapter in development without AWS credentials
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH="./storage"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_hmac_sha256_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another_super_secret_refresh_token_key_for_rotation_64_chars
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# AI Provider Integration (RAG, Summarization, Q&A)
# ------------------------------------------------------------------------------
# Supported providers: 'openai' | 'gemini' | 'anthropic' | 'mock'
AI_PROVIDER=mock
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL_NAME=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# AWS CloudWatch Telemetry
# ------------------------------------------------------------------------------
ENABLE_CLOUDWATCH=false
CLOUDWATCH_LOG_GROUP=/clouddoc/production/api
CLOUDWATCH_LOG_STREAM=ec2-instance-01

# ------------------------------------------------------------------------------
# SMTP / Email Verification
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.clouddoc.ai
SMTP_PASS=smtp_password_here
EMAIL_FROM="CloudDoc AI <support@clouddoc.ai>"
